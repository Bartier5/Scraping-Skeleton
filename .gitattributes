# ── .gitattributes ────────────────────────────────────────
# Force LF line endings in the repo for all text files.
# Git will handle conversion per-platform automatically.

* text=auto

# Explicitly LF for all Python and config files
*.py    text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.env   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf