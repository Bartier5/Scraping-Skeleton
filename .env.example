# ── .env.example ─────────────────────────────────────────
# Copy this to .env and fill in your real values.


# Request behavior
TIMEOUT=30
MAX_RETRIES=3
CONCURRENCY=10
DELAY_BETWEEN_REQUESTS=1.5

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/scraper.log

# Storage
STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite:///data/scraper.db

# Postgres 
POSTGRES_URL=postgresql://user:password@localhost:5432/scraper_db

# Proxy 
PROXY_LIST=proxies.txt